DATABASE_URL=postgres://orvyn:CHANGE_ME@127.0.0.1:5432/orvyn
ORVYN_DB_PASSWORD=CHANGE_ME
ORVYN_ORIGIN=http://localhost:3000
# Set NODE_ENV=production behind HTTPS to require Secure session cookies.

# Generate a random 32-byte hex key; share it across API and worker replicas.
ORVYN_ENCRYPTION_KEY=CHANGE_ME
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=orvyn@localhost.test
NUXT_API_URL=http://127.0.0.1:3001

REDIS_URL=redis://127.0.0.1:6379
COLLABORATION_PORT=3002
COLLABORATION_NAMESPACE=orvyn:collaboration
NUXT_PUBLIC_COLLABORATION_URL=ws://localhost:3002

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=orvyn
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
MAX_UPLOAD_BYTES=10485760

# Optional deployment-managed OIDC (production issuers require HTTPS).
# ORVYN_OIDC_ENABLED=true
# ORVYN_OIDC_NAME=Single sign-on
# ORVYN_OIDC_ISSUER=https://identity.example.org/realms/orvyn
# ORVYN_OIDC_CLIENT_ID=orvyn
# Supply ORVYN_OIDC_CLIENT_SECRET through your secret store.
# ORVYN_OIDC_CLIENT_AUTH_METHOD=client_secret_post
# ORVYN_OIDC_SCOPES=openid email profile
# ORVYN_OIDC_AUTO_PROVISION=true
# ORVYN_OIDC_ADMIN_SUBJECT=<exact-provider-subject>
# Kubernetes: external plus the configuration Job; single API: auto.
# ORVYN_OIDC_BOOTSTRAP_MODE=external
# Attachments default to S3 when no driver is set. local needs a shared private
# writable directory for API and worker; changing drivers does not migrate files.
ORVYN_STORAGE_DRIVER=s3
# ORVYN_STORAGE_LOCAL_PATH=/var/lib/orvyn/attachments
