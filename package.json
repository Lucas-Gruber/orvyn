{
  "name": "orvyn",
  "private": true,
  "version": "0.3.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "node --env-file=.env apps/api/node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "node apps/web/scripts/whiteboard-assets.mjs && node apps/web/scripts/mermaid-assets.mjs && node --env-file=.env apps/web/node_modules/nuxt/bin/nuxt.mjs dev apps/web --host 0.0.0.0",
    "build": "pnpm -r build",
    "test": "pnpm build && node --env-file=.env scripts/test.mjs",
    "infra:up": "docker compose --env-file .env -f infrastructure/compose/compose.yaml up -d --wait",
    "setup:local": "node scripts/local-env.mjs",
    "dev:worker": "node --env-file=.env apps/api/node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json apps/api/src/worker.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "admin:grant": "node --env-file=.env scripts/admin.mjs",
    "typecheck": "pnpm --filter @orvyn/shared build && pnpm --filter @orvyn/auth build && pnpm --filter @orvyn/editor build && pnpm --filter @orvyn/api build && pnpm --filter @orvyn/collaboration build && pnpm --filter @orvyn/web typecheck",
    "format": "prettier --write apps packages scripts tests package.json pnpm-workspace.yaml infrastructure",
    "dev:collaboration": "node --env-file=.env apps/collaboration/node_modules/tsx/dist/cli.mjs --tsconfig apps/collaboration/tsconfig.json apps/collaboration/src/main.ts",
    "storage:init": "node --env-file=.env scripts/storage-init.mjs",
    "backup:db": "node --env-file=.env scripts/db-backup.mjs",
    "restore:db": "node --env-file=.env scripts/db-restore.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "test:release": "node --test tests/release.test.mjs tests/release-platforms.test.mjs",
    "test:images": "node --env-file=.env scripts/test-images.mjs",
    "test:helm": "node scripts/test-helm.mjs",
    "test:kubernetes": "node scripts/test-kubernetes.mjs"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@playwright/test": "1.65.1",
    "prettier": "^3.10.1",
    "ws": "^8.23.0",
    "yaml": "2.9.1",
    "yjs": "13.6.33"
  },
  "packageManager": "pnpm@11.25.0"
}
