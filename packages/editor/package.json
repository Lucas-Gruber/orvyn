{
  "name": "@orvyn/editor",
  "private": true,
  "version": "0.3.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@orvyn/shared": "workspace:*",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-task-item": "3.34.0",
    "@tiptap/extension-task-list": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/y-tiptap": "3.3.0",
    "entities": "9.0.0",
    "lowlight": "3.3.0",
    "marked": "18.2.1",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "exports": {
    "./whiteboards": {
      "types": "./dist/whiteboard-model.d.ts",
      "default": "./dist/whiteboard-model.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./embeds": {
      "types": "./dist/embed-model.d.ts",
      "default": "./dist/embed-model.js"
    },
    "./comments": {
      "types": "./dist/comment-anchors.d.ts",
      "default": "./dist/comment-anchors.js"
    },
    "./mentions": {
      "types": "./dist/mention-model.d.ts",
      "default": "./dist/mention-model.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./markdown-export": {
      "types": "./dist/markdown-export.d.ts",
      "default": "./dist/markdown-export.js"
    }
  },
  "files": [
    "dist"
  ]
}
